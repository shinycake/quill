 namespace td {
 
+// Quill export extensions finish every initialized session before responding.
+// Each stage owns a separate one-shot ResultHandler.
+template <class ResultType>
+class FinishQuillTakeoutQuery final : public Td::ResultHandler {
+  Promise<td_api::object_ptr<ResultType>> promise_;
+  Result<td_api::object_ptr<ResultType>> result_;
+
+ public:
+  FinishQuillTakeoutQuery(Promise<td_api::object_ptr<ResultType>> &&promise,
+                         Result<td_api::object_ptr<ResultType>> &&result)
+      : promise_(std::move(promise)), result_(std::move(result)) {
+  }
+  void send(int64 takeout_id) {
+    telegram_api::object_ptr<telegram_api::Function> prefix =
+        telegram_api::make_object<telegram_api::invokeWithTakeoutPrefix>(takeout_id);
+    bool success = result_.is_ok();
+    send_query(G()->net_query_creator().create_with_prefix(
+        prefix, telegram_api::account_finishTakeoutSession(success ? 1 : 0, success), DcId::main()));
+  }
+  void on_result(BufferSlice packet) final {
+    auto result = fetch_result<telegram_api::account_finishTakeoutSession>(packet);
+    if (result.is_error()) {
+      return on_error(result.move_as_error());
+    }
+    if (!result.move_as_ok()) {
+      return on_error(Status::Error(500, "Takeout session was not finished"));
+    }
+    promise_.set_result(std::move(result_));
+  }
+  void on_error(Status status) final {
+    if (result_.is_error()) {
+      promise_.set_error(result_.move_as_error());
+    } else {
+      promise_.set_error(std::move(status));
+    }
+  }
+};
+
+class GetQuillSavedContactsQuery final : public Td::ResultHandler {
+  Promise<td_api::object_ptr<td_api::quillSavedContacts>> promise_;
+  int64 takeout_id_ = 0;
+
+ public:
+  explicit GetQuillSavedContactsQuery(Promise<td_api::object_ptr<td_api::quillSavedContacts>> &&promise)
+      : promise_(std::move(promise)) {
+  }
+  void send(int64 takeout_id) {
+    takeout_id_ = takeout_id;
+    telegram_api::object_ptr<telegram_api::Function> prefix =
+        telegram_api::make_object<telegram_api::invokeWithTakeoutPrefix>(takeout_id);
+    send_query(G()->net_query_creator().create_with_prefix(prefix, telegram_api::contacts_getSaved(), DcId::main()));
+  }
+  void on_result(BufferSlice packet) final {
+    auto result = fetch_result<telegram_api::contacts_getSaved>(packet);
+    if (result.is_error()) {
+      return on_error(result.move_as_error());
+    }
+    vector<td_api::object_ptr<td_api::quillSavedContact>> contacts;
+    for (auto &contact : result.move_as_ok()) {
+      contacts.push_back(td_api::make_object<td_api::quillSavedContact>(
+          std::move(contact->phone_), std::move(contact->first_name_), std::move(contact->last_name_), contact->date_));
+    }
+    td_->create_handler<FinishQuillTakeoutQuery<td_api::quillSavedContacts>>(
+        std::move(promise_), td_api::make_object<td_api::quillSavedContacts>(std::move(contacts)))->send(takeout_id_);
+  }
+  void on_error(Status status) final {
+    td_->create_handler<FinishQuillTakeoutQuery<td_api::quillSavedContacts>>(std::move(promise_), std::move(status))->send(takeout_id_);
+  }
+};
+
+class InitQuillContactsTakeoutQuery final : public Td::ResultHandler {
+  Promise<td_api::object_ptr<td_api::quillSavedContacts>> promise_;
+
+ public:
+  explicit InitQuillContactsTakeoutQuery(Promise<td_api::object_ptr<td_api::quillSavedContacts>> &&promise)
+      : promise_(std::move(promise)) {
+  }
+  void send() {
+    send_query(G()->net_query_creator().create(
+        telegram_api::account_initTakeoutSession(1, true, false, false, false, false, false, 0)));
+  }
+  void on_result(BufferSlice packet) final {
+    auto result = fetch_result<telegram_api::account_initTakeoutSession>(packet);
+    if (result.is_error()) {
+      return on_error(result.move_as_error());
+    }
+    td_->create_handler<GetQuillSavedContactsQuery>(std::move(promise_))->send(result.move_as_ok()->id_);
+  }
+  void on_error(Status status) final {
+    promise_.set_error(std::move(status));
+  }
+};
+
+class GetQuillTakeoutRangesQuery final : public Td::ResultHandler {
+  Promise<td_api::object_ptr<td_api::quillTakeoutMessageRanges>> promise_;
+  int64 takeout_id_ = 0;
+
+ public:
+  explicit GetQuillTakeoutRangesQuery(Promise<td_api::object_ptr<td_api::quillTakeoutMessageRanges>> &&promise)
+      : promise_(std::move(promise)) {
+  }
+  void send(int64 takeout_id) {
+    takeout_id_ = takeout_id;
+    telegram_api::object_ptr<telegram_api::Function> prefix =
+        telegram_api::make_object<telegram_api::invokeWithTakeoutPrefix>(takeout_id);
+    send_query(G()->net_query_creator().create_with_prefix(prefix, telegram_api::messages_getSplitRanges(), DcId::main()));
+  }
+  void on_result(BufferSlice packet) final {
+    auto result = fetch_result<telegram_api::messages_getSplitRanges>(packet);
+    if (result.is_error()) {
+      return on_error(result.move_as_error());
+    }
+    vector<td_api::object_ptr<td_api::quillTakeoutMessageRange>> ranges;
+    for (auto &range : result.move_as_ok()) {
+      ranges.push_back(td_api::make_object<td_api::quillTakeoutMessageRange>(range->min_id_, range->max_id_));
+    }
+    td_->create_handler<FinishQuillTakeoutQuery<td_api::quillTakeoutMessageRanges>>(
+        std::move(promise_), td_api::make_object<td_api::quillTakeoutMessageRanges>(std::move(ranges)))->send(takeout_id_);
+  }
+  void on_error(Status status) final {
+    td_->create_handler<FinishQuillTakeoutQuery<td_api::quillTakeoutMessageRanges>>(
+        std::move(promise_), std::move(status))->send(takeout_id_);
+  }
+};
+
+class InitQuillRangesTakeoutQuery final : public Td::ResultHandler {
+  Promise<td_api::object_ptr<td_api::quillTakeoutMessageRanges>> promise_;
+
+ public:
+  explicit InitQuillRangesTakeoutQuery(Promise<td_api::object_ptr<td_api::quillTakeoutMessageRanges>> &&promise)
+      : promise_(std::move(promise)) {
+  }
+  void send() {
+    send_query(G()->net_query_creator().create(
+        telegram_api::account_initTakeoutSession(30, false, true, true, true, true, false, 0)));
+  }
+  void on_result(BufferSlice packet) final {
+    auto result = fetch_result<telegram_api::account_initTakeoutSession>(packet);
+    if (result.is_error()) {
+      return on_error(result.move_as_error());
+    }
+    td_->create_handler<GetQuillTakeoutRangesQuery>(std::move(promise_))->send(result.move_as_ok()->id_);
+  }
+  void on_error(Status status) final {
+    promise_.set_error(std::move(status));
+  }
+};
