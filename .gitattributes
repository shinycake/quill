# Byte-exact inputs: Windows checkouts must not rewrite line endings.
schema/** -text
native/patches/** -text
native/quill-calls/patches/** -text
*.sh text eol=lf
*.py text eol=lf
# Compiled in with include_str! and parsed (SKILL.md frontmatter): keep LF on Windows.
src/agent/**/*.md text eol=lf
# Vendored ThorVG: kept byte for byte as scripts/vendor-thorvg.sh copied it.
third_party/thorvg/** -text
# Vendored widget runtime: the JS bundles are hashed against their .qbc and
# carry a version stamp on their first line, so CRLF on a Windows checkout
# made every widget refuse to start (#1425).
third_party/widgets/** -text
