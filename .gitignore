# Native build outputs (FFmpeg from scripts/build-ffmpeg.sh, the call library
# from scripts/build-tgcalls.sh) and their work trees, NEVER committed
vendor/

# Quill account data — live session state and keys must never be committed.
# (The ./quill-data fallback is gone; startup refuses without a platform data
# dir. These entries are the backstop against a broad `git add`.)
quill-data/
db-encryption.key
td.binlog
db.sqlite
db.sqlite-wal
db.sqlite-shm
.claude/worktrees/
# Vendored crate sources that the crate itself names `vendor/` (not the
# native build outputs above).
!third_party/*/vendor/
